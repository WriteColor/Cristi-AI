# ==============================================================================
# CRISTI AI COMPANION - CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como .env para configurar tus credenciales.
# Las credenciales sensibles se protegen mediante Windows DPAPI (safeStorage).

# 1. Google Gemini Multimodal Live API (OBLIGATORIO)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. Configuración de Entorno Local (Opcional)
CRISTI_WORKSPACE_PATH=
CRISTI_LOG_LEVEL=info
